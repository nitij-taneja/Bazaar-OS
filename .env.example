# --- Required for the core commerce flow -----------------------------------

# Razorpay Test Mode credentials (dashboard.razorpay.com -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Set after adding the webhook in Razorpay Dashboard -> Account & Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=

# Any random 32+ character string; signs session cookies.
JWT_SECRET=

# SQLite/libSQL database. Leave unset for local dev (falls back to a local
# ./local.db file automatically). In production, point this at a Turso
# database (turso.tech) so data persists across serverless invocations:
#   turso db create bazaar-os
#   turso db show bazaar-os --url          -> DATABASE_URL
#   turso db tokens create bazaar-os       -> DATABASE_AUTH_TOKEN
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# --- Optional: features degrade gracefully to deterministic logic without these ---

# console.groq.com - Hinglish intent understanding, voice transcription/TTS,
# and vision-based style tagging. Without it, deterministic fallbacks are used.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# huggingface.co/settings/tokens - real semantic product-search embeddings.
# Without it, lexical search still works.
HUGGINGFACE_API_KEY=

# --- Not needed outside the Manus platform (leave unset) --------------------
# OAUTH_SERVER_URL, BUILT_IN_FORGE_API_URL, BUILT_IN_FORGE_API_KEY
